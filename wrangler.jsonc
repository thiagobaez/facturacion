{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facturacion",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "facturacion.baez.com.ar", "custom_domain": true }],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/", "/api/*", "/facturas/*", "/lotes/*", "/f/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "facturacion",
      "database_id": "dc7c4ddb-8d47-41fe-a83d-a89642ad8f98",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARCHIVOS",
      "bucket_name": "facturacion-pdfs"
    }
  ],
  "vars": {
    "COOKIE_SEGURA": "true"
  }
}
